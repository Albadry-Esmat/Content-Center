# Content Center local development placeholders
# Copy this file to .env only when you need optional cloud workspace features.
# Never commit .env or place real provider credentials in this file.

# Optional browser-safe OAuth configuration for cloud workspace sign-in.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Optional server-side OAuth/session configuration.
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=
OWNER_NAME=

# Optional database connection for cloud workspace persistence.
DATABASE_URL=

# Analytics is intentionally optional and should remain disabled unless explicitly configured.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
